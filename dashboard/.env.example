# Vercel server-side values for live overview, automatic Opportunities, intake,
# and Knowledge base uploads. Supabase credentials stay in n8n. Do not commit real values.
OLIVESOFT_UPLOAD_TEAM_PASSWORD=
OLIVESOFT_N8N_UPLOAD_URL=
OLIVESOFT_N8N_UPLOAD_API_KEY=
# Set to 1 only after 006_pipeline_jobs.sql, 00_intake, 07_job_runner,
# and the updated read API are published and verified.
OLIVESOFT_N8N_ASYNC_INTAKE=

# Enable after renderer, proposal workflow, storage, and download live checks pass.
OLIVESOFT_N8N_PROPOSALS=
