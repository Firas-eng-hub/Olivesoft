    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id,l.title,l.source,l.raw_payload,l.extracted,l.relevance_score,l.status,l.deadline,l.created_at,l.updated_at,p.sector,p.evidence AS research_evidence,\n (SELECT json_agg(m ORDER BY m.score DESC) FROM matches m WHERE m.lead_id=l.id) AS matches,\n (SELECT json_agg(j ORDER BY j.requirement_id) FROM public.requirement_judgments j WHERE j.lead_id=l.id) AS judgments,\n (SELECT json_agg(json_build_object('id',a.id,'kind',a.kind,'mime_type',a.mime_type,'size_bytes',a.size_bytes,'created_at',a.created_at))\n  FROM public.pipeline_artifacts a JOIN public.pipeline_artifact_bundles b ON b.job_id=a.job_id\n  WHERE a.lead_id=l.id AND b.state='ready' AND a.verified_at IS NOT NULL) AS artifacts\n FROM leads l LEFT JOIN LATERAL (SELECT pr.sector,pr.evidence FROM prospects pr WHERE pr.lead_id=l.id ORDER BY pr.created_at DESC LIMIT 1) p ON true WHERE l.id=$1::uuid;",
        "options": {
          "queryReplacement": "={{ $json.lead_id }}"
        }
      },
      "id": "pg-lead",
      "name": "Lead Detail",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -96,
        80
