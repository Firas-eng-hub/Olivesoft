    {
      "id": "code-download-id",
      "name": "Resolve download ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
        1200
      ],
      "parameters": {
        "jsCode": "const id=String($json.query?.id??''); return [{json:{id:/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)?id:null}}];"
      }
    },
    {
      "id": "pg-download",
      "name": "Lookup ready artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -144,
        1200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH request AS (SELECT NULLIF($1,'')::uuid id) SELECT a.id,a.kind,a.mime_type,a.size_bytes,a.storage_bucket,a.storage_path FROM request LEFT JOIN LATERAL (SELECT a.* FROM public.pipeline_artifacts a JOIN public.pipeline_artifact_bundles b ON b.job_id=a.job_id WHERE a.id=request.id AND a.verified_at IS NOT NULL AND b.state='ready') a ON true;",
        "options": {
          "queryReplacement": "={{ $json.id || \"\" }}"
        }
      }
    },
    {
      "id": "if-download-found",
      "name": "Artifact found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        96,
        1200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "f61ac486-6562-423a-801c-a43e9e422e83",
              "leftValue": "={{ $json.id != null }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "http-sign",
      "name": "Sign private object",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        1104
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://okhntgauzbumgidpuyvx.supabase.co/storage/v1/object/sign/' + encodeURIComponent($json.storage_bucket) + '/' + $json.storage_path.split('/').map(encodeURIComponent).join('/') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({expiresIn:60}) }}",
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "code-sign-wrap",
      "name": "Wrap signed artifact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        1104
      ],
      "parameters": {
        "jsCode": "const a=$('Lookup ready artifact').first().json; const s=$json.signedURL??$json.signedUrl; if(!s||typeof s!=='string')throw Error('Storage did not return a signed URL'); return [{json:{id:a.id,kind:a.kind,mime_type:a.mime_type,size_bytes:a.size_bytes,signed_url:s}}];"
      }
    },
    {
      "id": "resp-signed",
      "name": "Respond signed artifact",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        784,
        1104
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "resp-download-missing",
      "name": "Respond missing artifact",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        320,
        1360
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({code:\"ARTIFACT_NOT_FOUND\",message:\"Artifact is not ready.\"}) }}",
        "options": {
          "responseCode": 404
        }
      }
    }
