    {
      "id": "pg-artifact",
      "name": "Get Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -96,
        320
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id,a.job_id,a.lead_id,a.kind,a.mime_type,a.size_bytes,b.version,a.created_at FROM public.pipeline_artifacts a JOIN public.pipeline_artifact_bundles b ON b.job_id=a.job_id WHERE a.id=$1::uuid AND b.state='ready' AND a.verified_at IS NOT NULL;",
        "options": {
          "queryReplacement": "={{ $json.artifact_id }}"
        }
      }
    },
