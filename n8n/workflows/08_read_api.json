      "id": "resolve-lead",
      "name": "Resolve Lead Id (detail)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id, l.title, l.source, l.raw_payload, l.extracted, l.relevance_score, l.status, l.deadline, l.created_at, l.updated_at,\n  p.sector,\n  (SELECT json_agg(m) FROM matches m WHERE m.lead_id = l.id) AS matches,\n  (SELECT json_agg(a) FROM artifacts a WHERE a.lead_id = l.id) AS artifacts\nFROM leads l\nLEFT JOIN LATERAL (\n  SELECT pr.sector FROM prospects pr WHERE pr.lead_id = l.id ORDER BY pr.id DESC LIMIT 1\n) p ON true\nWHERE l.id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ $json.lead_id }}"
        }
      },
      "id": "pg-lead",
      "name": "Lead Detail",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -96,
        80
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(row => row.id != null);\nif (!rows.length) return [{ json: { error: 'lead not found' } }];\nreturn [{ json: rows[0] }];"
      },
      "id": "wrap-lead",
      "name": "Wrap Lead Detail",
