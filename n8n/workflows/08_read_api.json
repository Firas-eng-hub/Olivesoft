      "name": "GET /lead?id=",
      "webhookId": "f8be17f3-5513-467f-b81d-f450b90f6f63",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -624,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const q = $json.query ?? {};\nreturn [{ json: { lead_id: q.id ?? '' } }];"
      },
      "id": "resolve-lead",
      "name": "Resolve Lead Id (detail)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id,l.title,l.source,l.raw_payload,l.extracted,l.relevance_score,l.status,l.deadline,l.created_at,l.updated_at,p.sector,\n (SELECT json_agg(m ORDER BY m.score DESC) FROM matches m WHERE m.lead_id=l.id) AS matches,\n (SELECT json_agg(json_build_object('id',a.id,'kind',a.kind,'mime_type',a.mime_type,'size_bytes',a.size_bytes,'version',a.version,'created_at',a.created_at)) FROM artifacts a WHERE a.lead_id=l.id AND a.size_bytes>0) AS artifacts\nFROM leads l LEFT JOIN LATERAL (SELECT pr.sector FROM prospects pr WHERE pr.lead_id=l.id ORDER BY pr.created_at DESC LIMIT 1) p ON true WHERE l.id=$1::uuid;",
        "options": {
          "queryReplacement": "={{ $json.lead_id }}"
        }
      },
      "id": "pg-lead",
      "name": "Lead Detail",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -96,
        80
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(row => row.id != null);\nif (!rows.length) return [{ json: { error: 'lead not found' } }];\nreturn [{ json: rows[0] }];"
      },
      "id": "wrap-lead",
      "name": "Wrap Lead Detail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
