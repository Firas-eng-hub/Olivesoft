    {
      "id": "pg-leads",
      "name": "List Leads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -368,
        -160
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id,l.title,l.source,l.extracted,l.raw_payload,l.relevance_score,l.status,l.deadline,l.created_at,l.updated_at,\n p.fit_score,p.mandatory_gaps,p.unknown_count,p.assessment,a.accepted_at,a.comments AS acceptance_comments,a.priorities AS acceptance_priorities,a.exclusions AS acceptance_exclusions\nFROM public.leads l LEFT JOIN public.opportunity_assessments p ON p.lead_id=l.id\nLEFT JOIN public.opportunity_acceptances a ON a.lead_id=l.id\nORDER BY l.updated_at DESC LIMIT 200;",
        "options": {}
      },
      "alwaysOutputData": true
    },
    {
      "id": "wrap-leads",
      "name": "Wrap Leads Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        -160
      ],
      "parameters": {
        "jsCode": "return [{ json: { items: $input.all().map(i => i.json).filter(row => row.id != null) } }];"
      }
    },
