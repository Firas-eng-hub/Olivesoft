    {
      "id": "pg-lead",
      "name": "Lead Detail",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -96,
        80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id,l.title,l.source,l.raw_payload,l.extracted,l.relevance_score,l.status,l.deadline,l.created_at,l.updated_at,p.sector,p.evidence AS research_evidence,fit.fit_score,fit.mandatory_gaps,fit.unknown_count,fit.assessment,acceptance.accepted_at,acceptance.comments AS acceptance_comments,acceptance.priorities AS acceptance_priorities,acceptance.exclusions AS acceptance_exclusions,\n (SELECT json_agg(m ORDER BY m.score DESC) FROM matches m WHERE m.lead_id=l.id) AS matches,\n (SELECT json_agg(j ORDER BY j.requirement_id) FROM public.requirement_judgments j WHERE j.lead_id=l.id) AS judgments,\n (SELECT json_agg(json_build_object('id',a.id,'kind',a.kind,'mime_type',a.mime_type,'size_bytes',a.size_bytes,'created_at',a.created_at))\n  FROM public.pipeline_artifacts a JOIN public.pipeline_artifact_bundles b ON b.job_id=a.job_id\n  WHERE a.lead_id=l.id AND b.state='ready' AND a.verified_at IS NOT NULL) AS artifacts\n FROM leads l LEFT JOIN public.opportunity_assessments fit ON fit.lead_id=l.id LEFT JOIN public.opportunity_acceptances acceptance ON acceptance.lead_id=l.id LEFT JOIN LATERAL (SELECT pr.sector,pr.evidence FROM prospects pr WHERE pr.lead_id=l.id ORDER BY pr.created_at DESC LIMIT 1) p ON true WHERE l.id=$1::uuid;",
        "options": {
          "queryReplacement": "={{ $json.lead_id }}"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "wrap-lead",
      "name": "Wrap Lead Detail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        80
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(row => row.id != null);\nif (!rows.length) return [{ json: { error: 'lead not found' } }];\nreturn [{ json: rows[0] }];"
      }
    },
