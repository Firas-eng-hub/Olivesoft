    {
      "id": "a47aa569-b7c0-4993-a4f3-2b96406808c5",
      "name": "List Knowledge Documents",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -350,
        1100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, doc_id, asset_type, title, version, state, metadata->>'storage_path' AS storage_path, created_at\nFROM (\n  SELECT DISTINCT ON (doc_id) id, doc_id, asset_type, title, version, state, metadata, created_at\n  FROM public.knowledge_documents\n  ORDER BY doc_id, version DESC\n) latest\nORDER BY created_at DESC\nLIMIT 200;",
        "options": {}
      }
    },
