      "webhookId": "9e730297-7cbb-449c-ba9d-bb91c859e96b"
    },
    {
      "id": "44438cc8-de38-4f74-a17c-7ebea915f507",
      "name": "Tavily Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        224
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({query:'software development OR cloud services public tender procurement site:ted.europa.eu OR site:find-tender.service.gov.uk',search_depth:'basic',max_results:10}) }}",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "dcec3442-8119-4a04-9fd9-a721117e96cb",
      "name": "Map Tavily results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        224
      ],
      "parameters": {
        "jsCode": "const rows=($json.results??[]).filter(x=>/^https:\\/\\//i.test(String(x.url??''))).slice(0,10).map(x=>({id:'tavily:'+String(x.url),title:String(x.title??'Untitled').slice(0,180),organization:'Review source',summary:String(x.content??'').replace(/\\s+/g,' ').slice(0,600),url:String(x.url),source:'Tavily',publishedAt:null})); return [{json:{items:rows,total:rows.length,source:'tavily'}}];"
      }
    },
    {
      "id": "8f9be381-3ac5-4049-a1cd-7e7cfb50efb9",
