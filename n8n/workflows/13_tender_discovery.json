    {
      "id": "ef1c7a25-7b63-45ed-8c1b-d75b24ff8cba",
      "name": "TED Search API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.ted.europa.eu/v3/notices/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({query:'classification-cpv=72000000 AND notice-type=cn-standard AND publication-date>='+$now.minus({days:14}).toFormat('yyyyMMdd'),fields:['publication-number','notice-title','buyer-name','publication-date','notice-type'],page:1,limit:15,paginationMode:'PAGE_NUMBER'}) }}",
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "73b2097d-8951-4a18-88f8-59ac08b02276",
      "name": "Map TED notices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const r=$json; if(r.timedOut) throw new Error('TED search timed out'); const take=(v)=>typeof v==='string'?v:(v&&typeof v==='object'?(v.eng??v.ENG??v.en??Object.values(v)[0]):''); const plain=(v)=>Array.isArray(v)?String(v[0]??''):String(v??''); const items=(r.notices??[]).slice(0,15).map(n=>{const id=String(n['publication-number']??'');return {id:'ted:'+id,title:plain(take(n['notice-title']))||id,organization:plain(take(n['buyer-name']))||'Unknown buyer',summary:'Official TED competition notice. Open the source to review the full scope and deadline.',url:'https://ted.europa.eu/en/notice/-/detail/'+id,source:'TED',publishedAt:String(n['publication-date']??'').slice(0,10)};}).filter(n=>n.id!=='ted:'); return [{json:{items,total:r.totalNoticeCount??items.length,source:'ted'}}];"
      }
    },
    {
      "id": "90d62c1c-2290-4005-9711-452703320443",
      "name": "Respond TED results",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        672,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      }
    },
    {
      "id": "a754f81f-9a18-44c1-8c81-0ae1ebaf312e",
