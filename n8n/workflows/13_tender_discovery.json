        "jsCode": "const rows=($json.organic_results??[]).filter(x=>/^https:\\/\\//i.test(String(x.link??''))).slice(0,10).map(x=>({id:'serpapi:'+String(x.link),title:String(x.title??'Untitled').slice(0,180),organization:'Review source',summary:String(x.snippet??'').replace(/\\s+/g,' ').slice(0,600),url:String(x.link),source:'SerpApi',publishedAt:null}));return [{json:{items:rows,total:rows.length,source:'serpapi'}}];"
      }
    }
