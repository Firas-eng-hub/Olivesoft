      "id": "code-validate",
      "name": "Validate intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ],
      "parameters": {
        "jsCode": "const b=$json.body??$json; if(!b||typeof b!=='object'||Array.isArray(b))return [{json:{valid:false,code:'INVALID_TENDER',message:'Tender must be an object.'}}]; const key=String(b.idempotency_key??'');\nconst title=String(b.title??'').trim(), organization=String(b.organization??'').trim(), summary=String(b.summary??'').trim();\nconst requirements=Array.isArray(b.requirements)?b.requirements.map(x=>String(x).trim()):[];\nconst deadline=b.deadline?String(b.deadline):null, source=String(b.source??'manual');\nlet source_url=b.source_url??null;\nif(source_url){try{const u=new URL(String(source_url));if(u.protocol!=='https:'||String(source_url).length>1000)throw Error();source_url=u.toString()}catch{return [{json:{valid:false,code:'INVALID_SOURCE_URL',message:'Source URL must be public HTTPS.'}}]}}\nif(requirements.length<1||requirements.length>50||requirements.some(x=>x.length<4||x.length>500)||key.length<8||key.length>200||title.length<4||title.length>100||organization.length<2||organization.length>80||summary.length<12||summary.length>700||!['manual','ted','tavily','serpapi'].includes(source)||deadline&&!/^\\d{4}-\\d{2}-\\d{2}$/.test(deadline))return [{json:{valid:false,code:'INVALID_TENDER',message:'Tender fields or idempotency key are invalid.'}}];\nreturn [{json:{valid:true,request_json:JSON.stringify({idempotency_key:key,input:{title,organization,summary,requirements,deadline,source,source_url}})}}];"
      }
    },
