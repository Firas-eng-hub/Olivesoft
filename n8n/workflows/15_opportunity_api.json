    {
      "id": "42d7457a-5332-4e84-823b-a46ed5fcd19c",
      "name": "List discovered opportunities",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -390,
        -200
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "WITH candidates AS (\n SELECT c.*,coalesce(c.lead_id,i.lead_id) AS resolved_lead_id\n FROM public.opportunity_candidates c\n LEFT JOIN public.pipeline_lead_identities i ON i.identity='team:'||c.source_url\n), ranked AS (\n SELECT c.*,row_number() OVER (\n   PARTITION BY coalesce(c.resolved_lead_id::text,c.source_url)\n   ORDER BY c.last_seen_at DESC,c.first_seen_at DESC) AS row_rank\n FROM candidates c\n)\nSELECT c.id,c.source,c.external_id,c.source_url,c.title,c.organization,c.summary,c.published_at,c.deadline,c.requirements,\n CASE WHEN c.resolved_lead_id IS NOT NULL THEN 'queued' ELSE c.status END AS status,\n c.resolved_lead_id AS lead_id,c.first_seen_at,c.last_seen_at,p.fit_score,p.mandatory_gaps,p.unknown_count,p.assessment,a.accepted_at\nFROM ranked c\nLEFT JOIN public.opportunity_assessments p ON p.lead_id=c.resolved_lead_id\nLEFT JOIN public.opportunity_acceptances a ON a.lead_id=c.resolved_lead_id\nWHERE c.row_rank=1\nORDER BY coalesce(c.published_at,c.first_seen_at::date) DESC,c.first_seen_at DESC LIMIT 200;",
        "options": {}
      },
      "alwaysOutputData": true
    },
