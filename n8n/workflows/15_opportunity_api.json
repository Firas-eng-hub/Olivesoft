    {
      "id": "e7bb9553-8361-4aed-a85b-367956547822",
      "name": "Validate candidate review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -390,
        580
      ],
      "parameters": {
        "jsCode": "const b=$json.body??$json;const uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;const key=String(b.idempotency_key??'');const input=b.input??{};const req=Array.isArray(input.requirements)?input.requirements:[];const title=String(input.title??'').trim(),org=String(input.organization??'').trim(),summary=String(input.summary??'').trim(),date=String(input.deadline??'');const dateValid=/^\\d{4}-\\d{2}-\\d{2}$/.test(date)&&!Number.isNaN(Date.parse(date))&&new Date(date).toISOString().slice(0,10)===date&&date>=new Date().toISOString().slice(0,10);const valid=uuid.test(String(b.candidate_id??''))&&key.length>=8&&key.length<=200&&input&&typeof input==='object'&&!Array.isArray(input)&&title.length>=4&&title.length<=100&&org.length>=2&&org.length<=80&&summary.length>=12&&summary.length<=700&&dateValid&&req.length>=1&&req.length<=50&&req.every(x=>typeof x==='string'&&x.trim().length>=4&&x.length<=500);return [{json:{valid,candidate_id:String(b.candidate_id??''),idempotency_key:key,input:{title,organization:org,summary,deadline:date,requirements:req.map(x=>x.trim())}}}];"
      }
