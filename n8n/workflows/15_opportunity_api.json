    {
      "id": "a0eb7e76-5be0-4086-96f0-1b68284d41c3",
      "name": "Validate acceptance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -390,
        180
      ],
      "parameters": {
        "jsCode": "const b=$json.body??$json;const id=String(b.lead_id??'');const fields=['comments','priorities','exclusions'];const values=Object.fromEntries(fields.map(k=>[k,typeof b[k]==='string'?b[k].trim():'']));const valid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)&&fields.every(k=>b[k]===undefined||typeof b[k]==='string')&&values.comments.length<=4000&&values.priorities.length<=2000&&values.exclusions.length<=2000;return [{json:{valid,lead_id:id,...values}}];"
      }
    },
    {
