# Local reference for the hosted n8n configuration. Add runtime values in Azure App Service.
# Storage workflows read these four variables directly.
OLIVESOFT_SUPABASE_URL=https://okhntgauzbumgidpuyvx.supabase.co
OLIVESOFT_SUPABASE_BUCKET=olivesoft-knowledge
OLIVESOFT_SUPABASE_SECRET_KEY=
OLIVESOFT_QDRANT_URL=
# Optional legacy anon key; no current server-side workflow reads it.
OLIVESOFT_SUPABASE_ANON_KEY=

# Enter these fields in an n8n Postgres credential. The current workflows do not
# read OLIVESOFT_DB_* directly from the environment.
OLIVESOFT_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
OLIVESOFT_DB_PORT=5432
OLIVESOFT_DB_NAME=postgres
OLIVESOFT_DB_USER=postgres.okhntgauzbumgidpuyvx
OLIVESOFT_DB_PASSWORD=

# Local reference only; hosted n8n reads these through its credentials.
# Bind the GLM key to the existing `z ai` credential, not a workflow export.
OLIVESOFT_GLM_API_KEY=
# Use the same fresh secret in the renderer Vercel project and n8n Header Auth
# credential `OliveSoft Proposal Renderer` (Authorization: Bearer ...).
OLIVESOFT_RENDERER_TOKEN=
